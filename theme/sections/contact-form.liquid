<div class="page-width page-width--narrow" style="padding-bottom: clamp(4rem, 8vw, 7rem);">
  <div class="page-header">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1 class="heading-italic">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<div class="muted" style="max-width:36rem;margin:0 auto;">{{ section.settings.text }}</div>{%- endif -%}
  </div>
  {%- form 'contact' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-message">{{ 'contact.success' | t }}</p>
    {%- elsif form.errors -%}
      <p class="form-message form-message--error">{{ form.errors | default_errors }}</p>
    {%- endif -%}
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0 1rem;">
      <div class="field">
        <label class="field__label" for="ContactName">{{ 'contact.name' | t }}</label>
        <input class="field__input" id="ContactName" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name">
      </div>
      <div class="field">
        <label class="field__label" for="ContactEmail">{{ 'contact.email' | t }} *</label>
        <input class="field__input" id="ContactEmail" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
      </div>
    </div>
    <div class="field">
      <label class="field__label" for="ContactPhone">{{ 'contact.phone' | t }}</label>
      <input class="field__input" id="ContactPhone" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
    </div>
    {%- if section.settings.show_subject -%}
      <div class="field">
        <label class="field__label" for="ContactSubject">{{ 'contact.subject' | t }}</label>
        <div class="select">
          <select class="select__select" id="ContactSubject" name="contact[asunto]">
            <option>{{ 'contact.subject_order' | t }}</option>
            <option>{{ 'contact.subject_sell' | t }}</option>
            <option>{{ 'contact.subject_product' | t }}</option>
            <option>{{ 'contact.subject_other' | t }}</option>
          </select>
        </div>
      </div>
    {%- endif -%}
    <div class="field">
      <label class="field__label" for="ContactBody">{{ 'contact.message' | t }}</label>
      <textarea id="ContactBody" name="contact[body]" rows="7">{{ form.body }}</textarea>
    </div>
    <button type="submit" class="button">{{ 'contact.send' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Formulario de contacto",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Contacto" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Hablemos" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>¿Dudas sobre una prenda o quieres vender las tuyas? Escríbenos y te respondemos en menos de 24h.</p>" },
    { "type": "checkbox", "id": "show_subject", "label": "Mostrar selector de asunto", "default": true }
  ],
  "presets": [{ "name": "Formulario de contacto" }]
}
{% endschema %}
