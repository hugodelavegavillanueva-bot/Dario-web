<section class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header{% if section.settings.center %} section-header--center{% endif %} reveal">
        <div>
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow{% unless section.settings.center %} eyebrow--line{% endunless %}">{{ section.settings.eyebrow }}</span>{%- endif -%}
          <h2 class="heading-italic">{{ section.settings.heading }}</h2>
        </div>
      </div>
    {%- endif -%}
    <div class="collection-tiles{% if section.settings.title_below %} collection-tiles--below{% endif %}" style="--cols: {{ section.settings.columns }}; --tile-ratio: {% if section.settings.ratio == 'square' %}1 / 1{% elsif section.settings.ratio == 'landscape' %}4 / 3{% else %}3 / 4{% endif %};">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- assign img = block.settings.image | default: c.featured_image -%}
        <a href="{{ c.url | default: '#' }}" class="collection-tile reveal" style="transition-delay: {{ forloop.index0 | times: 90 }}ms;" {{ block.shopify_attributes }}>
          <div class="collection-tile__media">
            {%- if img != blank -%}
              {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 50vw', widths: '400, 600, 800, 1200' }}
{%- elsif settings.show_demo_images and block.settings.demo != 'none' -%}
{% render 'demo-image', name: block.settings.demo %}
            {%- else -%}
              {%- assign n = forloop.index0 | modulo: 4 | plus: 1 -%}
              {%- assign ph = 'collection-apparel-' | append: n -%}
              <div class="card__placeholder">{{ ph | placeholder_svg_tag }}</div>
            {%- endif -%}
          </div>
          <div class="collection-tile__content">
            <h3 class="collection-tile__title">{{ block.settings.title | default: c.title | default: 'Colección' }}</h3>
            {%- if c != blank -%}<span class="collection-tile__count">{{ 'collections.items' | t: count: c.products_count }}</span>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lista de colecciones",
  "class": "section-collection-list",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Explorar"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Comprar por <em>categoría</em>"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columnas",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proporción",
      "options": [
        {
          "value": "portrait",
          "label": "Retrato"
        },
        {
          "value": "square",
          "label": "Cuadrada"
        },
        {
          "value": "landscape",
          "label": "Horizontal"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "center",
      "label": "Centrar título",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "surface",
      "label": "Fondo secundario",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "title_below",
      "label": "Título debajo de la imagen (estilo catálogo)",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Colección",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "select",
          "id": "demo",
          "label": "Foto de muestra (si no subes imagen)",
          "options": [
            {
              "value": "none",
              "label": "Ninguna"
            },
            {
              "value": "demo-perchero-tienda",
              "label": "Perchero de tienda"
            },
            {
              "value": "demo-boutique-clara",
              "label": "Boutique luminosa"
            },
            {
              "value": "demo-perchero-calido",
              "label": "Perchero cálido"
            },
            {
              "value": "demo-perchero-plumifero",
              "label": "Plumífero en perchero"
            },
            {
              "value": "demo-perchero-color",
              "label": "Perchero de colores"
            },
            {
              "value": "demo-boutique",
              "label": "Boutique"
            },
            {
              "value": "demo-chaquetas-plano",
              "label": "Chaquetas en plano"
            },
            {
              "value": "demo-sudaderas-perchero",
              "label": "Sudaderas en perchero"
            },
            {
              "value": "demo-camiseta-negra",
              "label": "Camiseta negra"
            },
            {
              "value": "demo-vaqueros",
              "label": "Vaqueros"
            },
            {
              "value": "demo-punto",
              "label": "Jerséis de punto"
            },
            {
              "value": "demo-camisa-blanca",
              "label": "Camisa blanca"
            },
            {
              "value": "demo-accesorios",
              "label": "Accesorios"
            },
            {
              "value": "demo-ropa-doblada",
              "label": "Ropa doblada"
            },
            {
              "value": "demo-outfit-plano",
              "label": "Outfit en plano"
            },
            {
              "value": "demo-outfit-plano-2",
              "label": "Outfit en plano 2"
            },
            {
              "value": "demo-vestido-perchero",
              "label": "Vestido en perchero"
            }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título personalizado"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen personalizada"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lista de colecciones",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "title": "Abrigos & Plumíferos"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Streetwear"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Sastrería"
          }
        }
      ]
    }
  ]
}
{% endschema %}
