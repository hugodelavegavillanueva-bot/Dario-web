<section class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header{% if section.settings.center %} section-header--center{% endif %} reveal">
        <div>
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow{% unless section.settings.center %} eyebrow--line{% endunless %}">{{ section.settings.eyebrow }}</span>{%- endif -%}
          <h2 class="heading-italic">{{ section.settings.heading }}</h2>
        </div>
      </div>
    {%- endif -%}
    <div class="collection-tiles" style="--cols: {{ section.settings.columns }}; --tile-ratio: {% if section.settings.ratio == 'square' %}1 / 1{% elsif section.settings.ratio == 'landscape' %}4 / 3{% else %}3 / 4{% endif %};">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- assign img = block.settings.image | default: c.featured_image -%}
        <a href="{{ c.url | default: '#' }}" class="collection-tile reveal" style="transition-delay: {{ forloop.index0 | times: 90 }}ms;" {{ block.shopify_attributes }}>
          <div class="collection-tile__media">
            {%- if img != blank -%}
              {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 50vw', widths: '400, 600, 800, 1200' }}
{%- elsif settings.show_demo_images and block.settings.demo != 'none' -%}
{% render 'demo-image', name: block.settings.demo %}
            {%- else -%}
              {%- assign n = forloop.index0 | modulo: 4 | plus: 1 -%}
              {%- assign ph = 'collection-apparel-' | append: n -%}
              <div class="card__placeholder">{{ ph | placeholder_svg_tag }}</div>
            {%- endif -%}
          </div>
          <div class="collection-tile__content">
            <h3 class="collection-tile__title">{{ block.settings.title | default: c.title | default: 'Colección' }}</h3>
            {%- if c != blank -%}<span class="collection-tile__count">{{ 'collections.items' | t: count: c.products_count }}</span>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lista de colecciones",
  "class": "section-collection-list",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Explorar"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Comprar por <em>categoría</em>"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columnas",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proporción",
      "options": [
        {
          "value": "portrait",
          "label": "Retrato"
        },
        {
          "value": "square",
          "label": "Cuadrada"
        },
        {
          "value": "landscape",
          "label": "Horizontal"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "center",
      "label": "Centrar título",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "surface",
      "label": "Fondo secundario",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Colección",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "select",
          "id": "demo",
          "label": "Foto de muestra (si no subes imagen)",
          "options": [
            {
              "value": "none",
              "label": "Ninguna"
            },
            {
              "value": "demo-plumifero-bosque",
              "label": "Plumífero – bosque"
            },
            {
              "value": "demo-streetwear-capucha",
              "label": "Streetwear – capucha"
            },
            {
              "value": "demo-plumifero-ciudad",
              "label": "Plumífero – ciudad"
            },
            {
              "value": "demo-parka-nieve",
              "label": "Parka – nieve"
            },
            {
              "value": "demo-plumifero-mujer",
              "label": "Plumífero – mujer"
            },
            {
              "value": "demo-plumifero-brillo",
              "label": "Plumífero brillante"
            },
            {
              "value": "demo-sudadera-grafica",
              "label": "Sudadera gráfica"
            },
            {
              "value": "demo-blazer",
              "label": "Blazer (sastrería)"
            },
            {
              "value": "demo-look-cuero",
              "label": "Look cuero"
            },
            {
              "value": "demo-perchero-plumifero",
              "label": "Plumífero en perchero"
            },
            {
              "value": "demo-boutique",
              "label": "Boutique"
            },
            {
              "value": "demo-perchero-color",
              "label": "Perchero de colores"
            },
            {
              "value": "demo-montana",
              "label": "Montaña / outdoor"
            },
            {
              "value": "demo-montana-espalda",
              "label": "Outdoor de espaldas"
            },
            {
              "value": "demo-sudadera-negra",
              "label": "Sudadera negra"
            },
            {
              "value": "demo-chandal",
              "label": "Chándal"
            },
            {
              "value": "demo-abrigo-borrego",
              "label": "Abrigo borrego"
            },
            {
              "value": "demo-camiseta",
              "label": "Camiseta streetwear"
            }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título personalizado"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen personalizada"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lista de colecciones",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "title": "Abrigos & Plumíferos"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Streetwear"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Sastrería"
          }
        }
      ]
    }
  ]
}
{% endschema %}
