<section class="section section--tight">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header reveal">
        <div>
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow eyebrow--line">{{ section.settings.eyebrow }}</span>{%- endif -%}
          <h2 class="heading-italic">{{ section.settings.heading }}</h2>
        </div>
        {%- if section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" target="_blank" rel="noopener" class="link-underline">{{ section.settings.link_label }} <span class="arrow">→</span></a>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="gallery" style="--cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: section.settings.link | default: '#' }}" class="gallery__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 17vw, 33vw', widths: '300, 450, 600' }}
{%- elsif settings.show_demo_images and block.settings.demo != 'none' -%}
{% render 'demo-image', name: block.settings.demo %}
          {%- else -%}
            {%- assign n = forloop.index0 | modulo: 4 | plus: 1 -%}
            {%- assign ph = 'product-apparel-' | append: n -%}
            <div class="card__placeholder">{{ ph | placeholder_svg_tag }}</div>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Galería / Instagram",
  "class": "section-gallery",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Síguenos"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "<em>@</em>tutienda"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace del perfil"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto del enlace",
      "default": "Ver en Instagram"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columnas",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Imagen",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "select",
          "id": "demo",
          "label": "Foto de muestra (si no subes imagen)",
          "options": [
            {
              "value": "none",
              "label": "Ninguna"
            },
            {
              "value": "demo-perchero-tienda",
              "label": "Perchero de tienda"
            },
            {
              "value": "demo-boutique-clara",
              "label": "Boutique luminosa"
            },
            {
              "value": "demo-perchero-calido",
              "label": "Perchero cálido"
            },
            {
              "value": "demo-perchero-plumifero",
              "label": "Plumífero en perchero"
            },
            {
              "value": "demo-perchero-color",
              "label": "Perchero de colores"
            },
            {
              "value": "demo-boutique",
              "label": "Boutique"
            },
            {
              "value": "demo-chaquetas-plano",
              "label": "Chaquetas en plano"
            },
            {
              "value": "demo-sudaderas-perchero",
              "label": "Sudaderas en perchero"
            },
            {
              "value": "demo-camiseta-negra",
              "label": "Camiseta negra"
            },
            {
              "value": "demo-vaqueros",
              "label": "Vaqueros"
            },
            {
              "value": "demo-punto",
              "label": "Jerséis de punto"
            },
            {
              "value": "demo-camisa-blanca",
              "label": "Camisa blanca"
            },
            {
              "value": "demo-accesorios",
              "label": "Accesorios"
            },
            {
              "value": "demo-ropa-doblada",
              "label": "Ropa doblada"
            },
            {
              "value": "demo-outfit-plano",
              "label": "Outfit en plano"
            },
            {
              "value": "demo-outfit-plano-2",
              "label": "Outfit en plano 2"
            },
            {
              "value": "demo-vestido-perchero",
              "label": "Vestido en perchero"
            }
          ],
          "default": "none"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Galería / Instagram",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
