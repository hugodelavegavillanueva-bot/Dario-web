<section class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    <div class="section-header reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow eyebrow--line">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="heading-italic">{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="look{% if section.settings.reverse %} look--reverse{% endif %}">
      <div class="look__media reveal">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 60vw, 100vw', widths: '600, 900, 1200, 1800' }}
        {%- elsif settings.show_demo_images and section.settings.demo != 'none' -%}
{% render 'demo-image', name: section.settings.demo %}
{%- else -%}
          <div class="card__placeholder">{{ 'hero-apparel-2' | placeholder_svg_tag }}</div>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          <button type="button" class="hotspot" style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%;" data-hotspot="{{ forloop.index0 }}" aria-label="{{ p.title | default: 'Producto' | escape }}" {{ block.shopify_attributes }}>
            <span></span>
          </button>
        {%- endfor -%}
      </div>
      <div class="look__list">
        {%- if section.settings.text != blank -%}<div class="muted rte" style="margin-bottom:2rem;">{{ section.settings.text }}</div>{%- endif -%}
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          <a href="{{ p.url | default: '#' }}" class="look__item" data-hotspot-item="{{ forloop.index0 }}">
            <span class="look__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="look__thumb">
              {%- if p.featured_media -%}
                {{ p.featured_media | image_url: width: 200 | image_tag: loading: 'lazy', alt: p.title }}
              {%- else -%}
                {%- assign n = forloop.index0 | modulo: 4 | plus: 1 -%}
                {%- assign ph = 'product-apparel-' | append: n -%}
                {{ ph | placeholder_svg_tag: 'placeholder-fill' }}
              {%- endif -%}
            </span>
            <span class="look__info">
              <span class="card__vendor">{%- if p != blank -%}{{ p.vendor }}{%- else -%}{{ 'placeholders.vendor' | t }}{%- endif -%}</span>
              <span class="card__title" style="display:block;margin:0;">{%- if p != blank -%}{{ p.title }}{%- else -%}{{ 'placeholders.pick_product' | t }}{%- endif -%}</span>
              {%- if p != blank -%}{% render 'price', product: p %}{%- endif -%}
            </span>
            <span class="arrow">→</span>
          </a>
        {%- endfor -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="button button--outline" style="margin-top:2rem;">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
