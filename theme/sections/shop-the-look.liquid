      "label": "Antetítulo",
      "default": "Lookbook"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Compra el <em>look</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Combinamos piezas de distintas casas para crear conjuntos con carácter. Pulsa sobre cada punto para ver la prenda.</p>"
    },
    {
      "type": "text",
