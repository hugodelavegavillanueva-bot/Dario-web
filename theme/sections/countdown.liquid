{%- liquid
  assign has_img = false
  if section.settings.image != blank
    assign has_img = true
  elsif settings.show_demo_images and section.settings.demo != 'none'
    assign has_img = true
  endif
  assign target = section.settings.date | append: 'T' | append: section.settings.time | append: ':00'
-%}
<section class="countdown{% if has_img %} countdown--image{% endif %}" data-countdown="{{ target }}">
  {%- if section.settings.image != blank -%}
    <div class="countdown__media">{{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', widths: '750, 1200, 1800, 2400' }}</div>
  {%- elsif has_img -%}
    <div class="countdown__media">{% render 'demo-image', name: section.settings.demo %}</div>
  {%- endif -%}
  <div class="page-width countdown__inner reveal">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="h1 heading-italic">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div class="countdown__text">{{ section.settings.text }}</div>{%- endif -%}
    <div class="countdown__timer" data-countdown-timer>
      <div><span data-cd="d">00</span><small>{{ 'countdown.days' | t }}</small></div>
      <div><span data-cd="h">00</span><small>{{ 'countdown.hours' | t }}</small></div>
      <div><span data-cd="m">00</span><small>{{ 'countdown.minutes' | t }}</small></div>
      <div><span data-cd="s">00</span><small>{{ 'countdown.seconds' | t }}</small></div>
    </div>
    <p class="countdown__done" data-countdown-done hidden>{{ section.settings.done_text }}</p>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="button {% if has_img %}button--light{% endif %}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cuenta atrás (Drop)",
  "class": "section-countdown",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de fondo"
    },
    {
      "type": "select",
      "id": "demo",
      "label": "Foto de muestra (si no subes imagen)",
      "options": [
        {
          "value": "none",
          "label": "Ninguna"
        },
        {
          "value": "demo-plumifero-bosque",
          "label": "Plumífero – bosque"
        },
        {
          "value": "demo-streetwear-capucha",
          "label": "Streetwear – capucha"
        },
        {
          "value": "demo-plumifero-ciudad",
          "label": "Plumífero – ciudad"
        },
        {
          "value": "demo-parka-nieve",
          "label": "Parka – nieve"
        },
        {
          "value": "demo-plumifero-mujer",
          "label": "Plumífero – mujer"
        },
        {
          "value": "demo-plumifero-brillo",
          "label": "Plumífero brillante"
        },
        {
          "value": "demo-sudadera-grafica",
          "label": "Sudadera gráfica"
        },
        {
          "value": "demo-blazer",
          "label": "Blazer (sastrería)"
        },
        {
          "value": "demo-look-cuero",
          "label": "Look cuero"
        },
        {
          "value": "demo-perchero-plumifero",
          "label": "Plumífero en perchero"
        },
        {
          "value": "demo-boutique",
          "label": "Boutique"
        },
        {
          "value": "demo-perchero-color",
          "label": "Perchero de colores"
        },
        {
          "value": "demo-montana",
          "label": "Montaña / outdoor"
        },
        {
          "value": "demo-montana-espalda",
          "label": "Outdoor de espaldas"
        },
        {
          "value": "demo-sudadera-negra",
          "label": "Sudadera negra"
        },
        {
          "value": "demo-chandal",
          "label": "Chándal"
        },
        {
          "value": "demo-abrigo-borrego",
          "label": "Abrigo borrego"
        },
        {
          "value": "demo-camiseta",
          "label": "Camiseta streetwear"
        }
      ],
      "default": "demo-montana"
    },
    {
      "type": "text",
      "id": "date",
      "label": "Fecha del lanzamiento",
      "default": "2026-12-01",
      "info": "Formato AAAA-MM-DD"
    },
    {
      "type": "text",
      "id": "time",
      "label": "Hora",
      "default": "20:00",
      "info": "Formato HH:MM (hora local del visitante)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Próximo drop"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Drop 002 · <em>Archivo invierno</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Más de 60 piezas de Moncler, Stone Island y Corteiz. Suscríbete para entrar antes que nadie.</p>"
    },
    {
      "type": "text",
      "id": "done_text",
      "label": "Texto al terminar",
      "default": "¡Ya disponible!"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón",
      "default": "Avísame"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace"
    }
  ],
  "presets": [
    {
      "name": "Cuenta atrás (Drop)"
    }
  ]
}
{% endschema %}
