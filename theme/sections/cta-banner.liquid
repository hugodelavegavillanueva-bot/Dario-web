<section class="cta-banner">
  <div class="cta-banner__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', widths: '750, 1200, 1800, 2400' }}
    {%- elsif settings.show_demo_images and section.settings.demo != 'none' -%}
{% render 'demo-image', name: section.settings.demo %}
    {%- endif -%}
  </div>
  <div class="page-width">
    <div class="cta-banner__content reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="h1">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="cta-banner__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--light">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner de llamada",
  "class": "section-cta-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de fondo"
    },
    {
      "type": "select",
      "id": "demo",
      "label": "Foto de muestra (si no subes imagen)",
      "options": [
        {
          "value": "none",
          "label": "Ninguna"
        },
        {
          "value": "demo-perchero-tienda",
          "label": "Perchero de tienda"
        },
        {
          "value": "demo-boutique-clara",
          "label": "Boutique luminosa"
        },
        {
          "value": "demo-perchero-calido",
          "label": "Perchero cálido"
        },
        {
          "value": "demo-perchero-plumifero",
          "label": "Plumífero en perchero"
        },
        {
          "value": "demo-perchero-color",
          "label": "Perchero de colores"
        },
        {
          "value": "demo-boutique",
          "label": "Boutique"
        },
        {
          "value": "demo-chaquetas-plano",
          "label": "Chaquetas en plano"
        },
        {
          "value": "demo-sudaderas-perchero",
          "label": "Sudaderas en perchero"
        },
        {
          "value": "demo-camiseta-negra",
          "label": "Camiseta negra"
        },
        {
          "value": "demo-vaqueros",
          "label": "Vaqueros"
        },
        {
          "value": "demo-punto",
          "label": "Jerséis de punto"
        },
        {
          "value": "demo-camisa-blanca",
          "label": "Camisa blanca"
        },
        {
          "value": "demo-accesorios",
          "label": "Accesorios"
        },
        {
          "value": "demo-ropa-doblada",
          "label": "Ropa doblada"
        },
        {
          "value": "demo-outfit-plano",
          "label": "Outfit en plano"
        },
        {
          "value": "demo-outfit-plano-2",
          "label": "Outfit en plano 2"
        },
        {
          "value": "demo-vestido-perchero",
          "label": "Vestido en perchero"
        }
      ],
      "default": "demo-perchero-calido"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Vende con nosotros"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "¿Tu armario tiene <em>joyas</em> olvidadas?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Compramos y vendemos en consignación prendas de marcas premium en excelente estado. Te respondemos en menos de 48h.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón",
      "default": "Enviar mis prendas"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace"
    }
  ],
  "presets": [
    {
      "name": "Banner de llamada"
    }
  ]
}
{% endschema %}
