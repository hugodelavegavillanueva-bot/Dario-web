<section class="video-banner" data-video-banner style="--vb-height: {{ section.settings.height }}vh;">
  <div class="video-banner__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1920x' }}
    {%- elsif section.settings.poster != blank -%}
      {{ section.settings.poster | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw' }}
{%- elsif settings.show_demo_images and section.settings.demo != 'none' -%}
{% render 'demo-image', name: section.settings.demo %}
    {%- else -%}
      <div class="hero__placeholder">{{ 'hero-apparel-2' | placeholder_svg_tag }}</div>
    {%- endif -%}
  </div>
  <div class="page-width video-banner__content reveal">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="h0 heading-italic">{{ section.settings.heading }}</h2>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="button button--light">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
  {%- if section.settings.video != blank -%}
    <button type="button" class="video-banner__toggle" data-video-toggle aria-label="Pausa / Play">❚❚</button>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Vídeo a pantalla completa",
  "class": "section-video-banner",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Vídeo (se sube a Shopify)"
    },
    {
      "type": "select",
      "id": "demo",
      "label": "Foto de muestra (si no subes imagen)",
      "options": [
        {
          "value": "none",
          "label": "Ninguna"
        },
        {
          "value": "demo-perchero-tienda",
          "label": "Perchero de tienda"
        },
        {
          "value": "demo-boutique-clara",
          "label": "Boutique luminosa"
        },
        {
          "value": "demo-perchero-calido",
          "label": "Perchero cálido"
        },
        {
          "value": "demo-perchero-plumifero",
          "label": "Plumífero en perchero"
        },
        {
          "value": "demo-perchero-color",
          "label": "Perchero de colores"
        },
        {
          "value": "demo-boutique",
          "label": "Boutique"
        },
        {
          "value": "demo-chaquetas-plano",
          "label": "Chaquetas en plano"
        },
        {
          "value": "demo-sudaderas-perchero",
          "label": "Sudaderas en perchero"
        },
        {
          "value": "demo-camiseta-negra",
          "label": "Camiseta negra"
        },
        {
          "value": "demo-vaqueros",
          "label": "Vaqueros"
        },
        {
          "value": "demo-punto",
          "label": "Jerséis de punto"
        },
        {
          "value": "demo-camisa-blanca",
          "label": "Camisa blanca"
        },
        {
          "value": "demo-accesorios",
          "label": "Accesorios"
        },
        {
          "value": "demo-ropa-doblada",
          "label": "Ropa doblada"
        },
        {
          "value": "demo-outfit-plano",
          "label": "Outfit en plano"
        },
        {
          "value": "demo-outfit-plano-2",
          "label": "Outfit en plano 2"
        },
        {
          "value": "demo-vestido-perchero",
          "label": "Vestido en perchero"
        }
      ],
      "default": "demo-perchero-calido"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Imagen si no hay vídeo"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Altura",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 80
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Campaña"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Hecho para <em>durar</em>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón",
      "default": "Ver colección"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace"
    }
  ],
  "presets": [
    {
      "name": "Vídeo a pantalla completa"
    }
  ]
}
{% endschema %}
