    {
      "type": "image_picker",
      "id": "poster",
      "label": "Imagen si no hay vídeo"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Altura",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 80
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Campaña"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Hecho para <em>durar</em>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón",
      "default": "Ver colección"
    },
    {
