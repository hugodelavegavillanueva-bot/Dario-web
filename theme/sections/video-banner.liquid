<section class="video-banner" data-video-banner style="--vb-height: {{ section.settings.height }}vh;">
  <div class="video-banner__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1920x' }}
    {%- elsif section.settings.poster != blank -%}
      {{ section.settings.poster | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw' }}
{%- elsif settings.show_demo_images and section.settings.demo != 'none' -%}
{% render 'demo-image', name: section.settings.demo %}
    {%- else -%}
      <div class="hero__placeholder">{{ 'hero-apparel-2' | placeholder_svg_tag }}</div>
    {%- endif -%}
  </div>
  <div class="page-width video-banner__content reveal">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="h0 heading-italic">{{ section.settings.heading }}</h2>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="button button--light">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
  {%- if section.settings.video != blank -%}
    <button type="button" class="video-banner__toggle" data-video-toggle aria-label="Pausa / Play">❚❚</button>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Vídeo a pantalla completa",
  "class": "section-video-banner",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Vídeo (se sube a Shopify)"
    },
    {
      "type": "select",
      "id": "demo",
      "label": "Foto de muestra (si no subes imagen)",
      "options": [
        {
          "value": "none",
          "label": "Ninguna"
        },
        {
          "value": "demo-plumifero-bosque",
          "label": "Plumífero – bosque"
        },
        {
          "value": "demo-streetwear-capucha",
          "label": "Streetwear – capucha"
        },
        {
          "value": "demo-plumifero-ciudad",
          "label": "Plumífero – ciudad"
        },
        {
          "value": "demo-parka-nieve",
          "label": "Parka – nieve"
        },
        {
          "value": "demo-plumifero-mujer",
          "label": "Plumífero – mujer"
        },
        {
          "value": "demo-plumifero-brillo",
          "label": "Plumífero brillante"
        },
        {
          "value": "demo-sudadera-grafica",
          "label": "Sudadera gráfica"
        },
        {
          "value": "demo-blazer",
          "label": "Blazer (sastrería)"
        },
        {
          "value": "demo-look-cuero",
          "label": "Look cuero"
        },
        {
          "value": "demo-perchero-plumifero",
          "label": "Plumífero en perchero"
        },
        {
          "value": "demo-boutique",
          "label": "Boutique"
        },
        {
          "value": "demo-perchero-color",
          "label": "Perchero de colores"
        },
        {
          "value": "demo-montana",
          "label": "Montaña / outdoor"
        },
        {
          "value": "demo-montana-espalda",
          "label": "Outdoor de espaldas"
        },
        {
          "value": "demo-sudadera-negra",
          "label": "Sudadera negra"
        },
        {
          "value": "demo-chandal",
          "label": "Chándal"
        },
        {
          "value": "demo-abrigo-borrego",
