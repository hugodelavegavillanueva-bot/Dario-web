{%- comment -%} Renderizado por JS vía /products/<handle>?section_id=quick-view {%- endcomment -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
<div class="quick-view" data-product>
  <div class="quick-view__media">
    {%- for media in product.media limit: 6 -%}
      {%- if media.media_type == 'image' -%}
        <div class="quick-view__img">{{ media | image_url: width: 900 | image_tag: loading: 'lazy', alt: media.alt, sizes: '(min-width: 750px) 460px, 90vw' }}</div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="quick-view__info">
    <a href="{{ product.vendor | url_for_vendor }}" class="product-info__vendor">{{ product.vendor }}</a>
    <h2 class="product-info__title h3">{{ product.title | escape }}</h2>
    {% render 'price', product: product, variant: current_variant, show_saving: true, data_attr: true %}
    {%- capture condition_spec -%}{% render 'product-condition', product: product, style: 'spec' %}{%- endcapture -%}
    {%- capture size_text -%}{% render 'product-size', product: product %}{%- endcapture -%}
    <div class="spec-list" style="margin-top:1.5rem;">
      {%- if size_text != blank -%}<div class="spec-list__item"><span class="spec-list__label">{{ 'products.product.size' | t }}</span><span class="spec-list__value">{{ size_text }}</span></div>{%- endif -%}
      {%- if condition_spec != blank -%}<div class="spec-list__item"><span class="spec-list__label">{{ 'products.product.condition' | t }}</span><span class="spec-list__value">{{ condition_spec }}</span></div>{%- endif -%}
    </div>
    {%- form 'product', product, data-ajax-cart: '' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}">
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          {%- if option.values.size > 1 -%}
            <fieldset class="variant-picker" data-option-index="{{ forloop.index0 }}">
              <legend><span>{{ option.name }}: <span data-selected-value>{{ option.selected_value }}</span></span></legend>
              <div class="variant-picker__options">
                {%- for value in option.values -%}
                  <label class="variant-picker__option"><input type="radio" name="qv-option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}><span>{{ value }}</span></label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- else -%}
            <fieldset data-option-index="{{ forloop.index0 }}" hidden><input type="radio" name="qv-option-{{ forloop.index0 }}" value="{{ option.values.first | escape }}" checked></fieldset>
          {%- endif -%}
        {%- endfor -%}
      {%- endunless -%}
      <div class="product-form__buttons">
        <button type="submit" class="button button--full"{% unless current_variant.available %} disabled{% endunless %}>
          <span>{%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</span>
        </button>
      </div>
      <p class="product-form__error" role="alert"></p>
    {%- endform -%}
    <a href="{{ product.url }}" class="link-underline">{{ 'products.product.view_details' | t }} <span class="arrow">→</span></a>
  </div>
  <script type="application/json" data-product-json>
    {"id": {{ product.id }}, "variants": [{%- for v in product.variants -%}{"id": {{ v.id }}, "options": {{ v.options | json }}, "price": {{ v.price }}, "compare_at_price": {{ v.compare_at_price | default: 0 }}, "available": {{ v.available }}, "featured_media": null}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}
  </script>
</div>
{% schema %}
{ "name": "Vista rápida (interno)" }
{% endschema %}
