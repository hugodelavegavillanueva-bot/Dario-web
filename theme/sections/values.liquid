<section class="section{% if section.settings.style == 'dark' %} section--dark{% elsif section.settings.style == 'surface' %} section--surface{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header section-header--center reveal">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="heading-italic">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="values" style="--cols: {{ section.blocks.size | at_most: 4 | at_least: 1 }};">
      {%- for block in section.blocks -%}
        <div class="value reveal" style="transition-delay: {{ forloop.index0 | times: 100 }}ms;" {{ block.shopify_attributes }}>
          {%- if section.settings.show_numbers -%}
            <span class="value__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- else -%}
            <span class="value__icon">{% render 'icon', icon: block.settings.icon %}</span>
          {%- endif -%}
          <h3 class="value__title">{{ block.settings.title }}</h3>
          <div class="value__text">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Garantías / Valores",
  "class": "section-values",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select", "id": "style", "label": "Estilo",
      "options": [
        { "value": "default", "label": "Claro" },
        { "value": "surface", "label": "Secundario" },
        { "value": "dark", "label": "Oscuro" }
      ],
      "default": "default"
    },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Por qué comprar aquí" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Segunda mano, <em>primera clase</em>" },
    { "type": "checkbox", "id": "show_numbers", "label": "Mostrar números en lugar de iconos", "default": false }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Garantía",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icono",
          "options": [
            { "value": "shield", "label": "Escudo (autenticidad)" },
            { "value": "sparkle", "label": "Brillo (estado)" },
            { "value": "truck", "label": "Camión (envío)" },
            { "value": "return", "label": "Flecha (devolución)" },
            { "value": "leaf", "label": "Hoja (sostenible)" },
            { "value": "tag", "label": "Etiqueta (precio)" },
            { "value": "camera", "label": "Cámara (fotos reales)" },
            { "value": "hanger", "label": "Percha (prenda)" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "title", "label": "Título", "default": "100% auténtico" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Cada pieza verificada por expertos antes de publicarse.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Garantías / Valores",
      "blocks": [
        { "type": "value", "settings": { "icon": "shield", "title": "100% auténtico", "text": "<p>Cada pieza se verifica por expertos antes de publicarse. Si no es auténtica, te devolvemos el dinero.</p>" } },
        { "type": "value", "settings": { "icon": "sparkle", "title": "Casi nuevo", "text": "<p>Solo aceptamos prendas en estado excelente o superior. Sin sorpresas.</p>" } },
        { "type": "value", "settings": { "icon": "camera", "title": "Fotos reales", "text": "<p>Fotografiamos la prenda exacta que recibirás, con todos sus detalles.</p>" } },
        { "type": "value", "settings": { "icon": "truck", "title": "Envío asegurado", "text": "<p>Embalaje premium y envío con seguimiento en 24/48h.</p>" } }
      ]
    }
  ]
}
{% endschema %}
