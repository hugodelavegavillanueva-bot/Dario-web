<div class="page-width" style="padding-bottom: clamp(4rem, 8vw, 7rem);">
  <div class="page-header">
    <span class="eyebrow">Journal</span>
    <h1>{{ blog.title }}</h1>
  </div>
  {%- paginate blog.articles by 9 -%}
    <div class="article-grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="article-card">
          <div class="article-card__media">
            {%- if article.image -%}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '400, 600, 900' }}
            {%- else -%}
              {%- assign n = forloop.index0 | modulo: 3 | plus: 1 -%}
              {%- assign ph = 'blog-apparel-' | append: n -%}
              {{ ph | placeholder_svg_tag: 'placeholder-fill' }}
            {%- endif -%}
          </div>
          <span class="eyebrow" style="margin-bottom:0.6rem;">{{ article.published_at | date: format: 'date' }}</span>
          <h2 class="article-card__title">{{ article.title | escape }}</h2>
          {%- if article.excerpt != blank -%}<p class="muted">{{ article.excerpt | strip_html | truncatewords: 24 }}</p>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog" }
{% endschema %}
