<div class="password-page">
  <div style="max-width:36rem;">
    <p class="footer__brand-name" style="margin-bottom:2rem;">{{ shop.name }}</p>
    <h1 class="h1 heading-italic">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p style="opacity:0.75;">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
      {%- if form.posted_successfully? -%}
        <p style="margin-top:2rem;">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter__form">
          <input type="email" name="contact[email]" class="newsletter__input" placeholder="{{ 'newsletter.placeholder' | t }}" required aria-label="{{ 'newsletter.placeholder' | t }}">
          <button type="submit" class="newsletter__submit">{{ 'newsletter.button' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
    <details style="margin-top:3rem;font-size:0.8125rem;opacity:0.8;">
      <summary style="cursor:pointer;">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p>{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="newsletter__form">
          <input type="password" name="password" class="newsletter__input" placeholder="{{ 'password.password' | t }}" aria-label="{{ 'password.password' | t }}">
          <button type="submit" class="newsletter__submit">{{ 'password.enter_button' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Página de contraseña",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Muy <em>pronto</em>" }
  ]
}
{% endschema %}
