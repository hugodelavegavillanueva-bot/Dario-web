{%- assign blog = section.settings.blog | default: blogs.news -%}
<section class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    <div class="section-header reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow eyebrow--line">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="heading-italic">{{ section.settings.heading }}</h2>
      </div>
      {%- if blog != blank -%}<a href="{{ blog.url }}" class="link-underline">{{ 'general.view_all' | t }} <span class="arrow">→</span></a>{%- endif -%}
    </div>
    <div class="article-grid">
      {%- for article in blog.articles limit: section.settings.limit -%}
        <a href="{{ article.url }}" class="article-card reveal">
          <div class="article-card__media">
            {%- if article.image -%}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '400, 600, 900' }}
            {%- endif -%}
          </div>
          <span class="eyebrow" style="margin-bottom:0.6rem;">{{ article.published_at | date: format: 'date' }}</span>
          <h3 class="article-card__title">{{ article.title | escape }}</h3>
          {%- if article.excerpt != blank -%}<p class="muted">{{ article.excerpt | strip_html | truncatewords: 20 }}</p>{%- endif -%}
        </a>
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="article-card">
            <div class="article-card__media"></div>
            <span class="eyebrow">Journal</span>
            <h3 class="article-card__title">Cómo identificar un Moncler auténtico</h3>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog destacado",
  "class": "section-featured-blog",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "limit", "label": "Artículos", "min": 3, "max": 9, "step": 3, "default": 3 },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Journal" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Guías y <em>autenticación</em>" },
    { "type": "checkbox", "id": "surface", "label": "Fondo secundario", "default": false }
  ],
  "presets": [{ "name": "Blog destacado" }]
}
{% endschema %}
