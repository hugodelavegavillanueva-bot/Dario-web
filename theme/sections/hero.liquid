{%- liquid
  assign height = section.settings.height
  case height
    when 'full'
      assign h = '100vh'
    when 'large'
      assign h = '88vh'
    else
      assign h = '70vh'
  endcase
-%}
{%- if section.settings.layout == 'split' -%}
  <section class="hero-split" style="--hero-height: {{ h }};">
    <div class="hero-split__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 750px) 50vw, 100vw', widths: '600, 900, 1200, 1600, 2000' }}
      {%- elsif settings.show_demo_images and section.settings.demo != 'none' -%}
{% render 'demo-image', name: section.settings.demo, eager: true %}
{%- else -%}
        <div class="hero__placeholder">{{ 'hero-apparel-3' | placeholder_svg_tag }}</div>
      {%- endif -%}
    </div>
    <div class="hero-split__content reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow eyebrow--line">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="h0 heading-italic" style="max-width:12ch;">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="muted" style="max-width:30rem;margin-bottom:2.25rem;">{{ section.settings.text }}</div>{%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link }}" class="button">{{ section.settings.button_label }}</a>{%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}<a href="{{ section.settings.button_link_2 }}" class="button button--outline">{{ section.settings.button_label_2 }}</a>{%- endif -%}
      </div>
    </div>
  </section>
{%- else -%}
  <section class="hero{% if section.settings.align == 'center' %} hero--center{% endif %}" style="--hero-height: {{ h }}; --hero-overlay: {{ section.settings.overlay | divided_by: 100.0 }};">
    <div class="hero__media">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '2000x' }}
      {%- elsif section.settings.image != blank -%}
        {%- if section.settings.image_mobile != blank -%}
          <picture>
            <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1000 }}">
            {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 1920, 2400' }}
          </picture>
        {%- else -%}
          {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 1920, 2400' }}
        {%- endif -%}
      {%- elsif settings.show_demo_images and section.settings.demo != 'none' -%}
{% render 'demo-image', name: section.settings.demo, eager: true %}
{%- else -%}
        <div class="hero__placeholder">{{ 'hero-apparel-2' | placeholder_svg_tag }}</div>
      {%- endif -%}
    </div>
    <div class="page-width hero__content">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow eyebrow--line">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="h0 hero__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="hero__text">{{ section.settings.text }}</div>{%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link }}" class="button button--light">{{ section.settings.button_label }}</a>{%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}<a href="{{ section.settings.button_link_2 }}" class="button button--light button--outline">{{ section.settings.button_label_2 }}</a>{%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Hero / Portada",
  "tag": "div",
  "class": "section-hero",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Diseño",
      "options": [
        {
          "value": "full",
          "label": "Imagen a pantalla completa"
        },
        {
          "value": "split",
          "label": "Imagen + texto (dividido)"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "demo",
      "label": "Foto de muestra (si no subes imagen)",
      "options": [
        {
          "value": "none",
          "label": "Ninguna"
        },
        {
          "value": "demo-perchero-tienda",
          "label": "Perchero de tienda"
        },
        {
          "value": "demo-boutique-clara",
          "label": "Boutique luminosa"
        },
        {
          "value": "demo-perchero-calido",
          "label": "Perchero cálido"
        },
        {
          "value": "demo-perchero-plumifero",
          "label": "Plumífero en perchero"
        },
        {
          "value": "demo-perchero-color",
          "label": "Perchero de colores"
        },
        {
          "value": "demo-boutique",
          "label": "Boutique"
        },
        {
          "value": "demo-chaquetas-plano",
          "label": "Chaquetas en plano"
        },
        {
          "value": "demo-sudaderas-perchero",
          "label": "Sudaderas en perchero"
        },
        {
          "value": "demo-camiseta-negra",
          "label": "Camiseta negra"
        },
        {
          "value": "demo-vaqueros",
          "label": "Vaqueros"
        },
        {
          "value": "demo-punto",
          "label": "Jerséis de punto"
        },
        {
          "value": "demo-camisa-blanca",
          "label": "Camisa blanca"
        },
        {
          "value": "demo-accesorios",
          "label": "Accesorios"
        },
        {
          "value": "demo-ropa-doblada",
          "label": "Ropa doblada"
        },
        {
          "value": "demo-outfit-plano",
          "label": "Outfit en plano"
        },
        {
          "value": "demo-outfit-plano-2",
          "label": "Outfit en plano 2"
        },
        {
          "value": "demo-vestido-perchero",
          "label": "Vestido en perchero"
        }
      ],
      "default": "demo-perchero-tienda"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen para móvil (opcional)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Vídeo (opcional, sustituye a la imagen)"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Altura",
      "options": [
        {
          "value": "full",
          "label": "Pantalla completa"
        },
        {
          "value": "large",
          "label": "Grande"
        },
        {
          "value": "medium",
          "label": "Media"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alineación del texto",
      "options": [
        {
          "value": "left",
          "label": "Abajo a la izquierda"
        },
        {
          "value": "center",
          "label": "Centrado"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Oscurecer imagen",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Archivo curado · Segunda mano"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "info": "Usa cursiva para resaltar palabras.",
      "default": "Lujo con <em>segunda</em> vida"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Piezas seleccionadas de las casas más deseadas — de Moncler a Corteiz — verificadas y en estado casi nuevo.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón 1",
      "default": "Descubrir la colección"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace botón 1",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Botón 2",
      "default": "Marcas"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Enlace botón 2"
    }
  ],
  "presets": [
    {
      "name": "Hero / Portada"
    }
  ]
}
{% endschema %}
