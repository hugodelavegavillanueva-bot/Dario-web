<div class="page-width" style="padding-bottom: clamp(4rem, 8vw, 7rem);">
  <div class="page-header">
    <h1 class="heading-italic">{{ section.settings.heading }}</h1>
  </div>
  <div class="collection-tiles" style="--cols: {{ section.settings.columns }};">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <a href="{{ collection.url }}" class="collection-tile">
          <div class="collection-tile__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 50vw', widths: '400, 600, 800, 1000' }}
            {%- else -%}
              {%- assign n = forloop.index0 | modulo: 4 | plus: 1 -%}
              {%- assign ph = 'collection-apparel-' | append: n -%}
              <div class="card__placeholder">{{ ph | placeholder_svg_tag }}</div>
            {%- endif -%}
          </div>
          <div class="collection-tile__content">
            <h2 class="collection-tile__title">{{ collection.title }}</h2>
            <span class="collection-tile__count">{{ 'collections.items' | t: count: collection.products_count }}</span>
          </div>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Lista de colecciones",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Todas las <em>colecciones</em>" },
    { "type": "range", "id": "columns", "label": "Columnas", "min": 2, "max": 4, "step": 1, "default": 3 }
  ]
}
{% endschema %}
