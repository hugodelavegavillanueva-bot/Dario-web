<div class="cart-item">
  <a href="{{ item.url }}" class="cart-item__media">
    {%- if item.image -%}
      {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.image.alt }}
    {%- endif -%}
  </a>
  <div>
    {%- if item.vendor != blank -%}<p class="cart-item__vendor">{{ item.vendor }}</p>{%- endif -%}
    <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
    {%- unless item.product.has_only_default_variant -%}
      <p class="cart-item__options">
        {%- for option in item.options_with_values -%}
          {{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}
        {%- endfor -%}
      </p>
    {%- endunless -%}
    {%- if item.variant.inventory_management != blank and item.variant.inventory_quantity <= 1 and item.variant.inventory_policy == 'deny' -%}
      <p class="cart-item__options">{{ 'products.product.unique_piece' | t }}</p>
    {%- else -%}
      <div class="qty" data-key="{{ item.key }}">
        <button type="button" data-qty-step="-1" aria-label="−">−</button>
        <input type="number" value="{{ item.quantity }}" min="0" readonly aria-label="{{ 'cart.quantity' | t }}">
        <button type="button" data-qty-step="1" aria-label="+">+</button>
      </div>
    {%- endif -%}
    <div><button type="button" class="cart-item__remove" data-line-remove="{{ item.key }}">{{ 'cart.remove' | t }}</button></div>
  </div>
  <div class="cart-item__price">
    {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
    {{ item.final_line_price | money }}
  </div>
</div>
