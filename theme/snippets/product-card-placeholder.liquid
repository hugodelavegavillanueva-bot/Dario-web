{%- comment -%}
  Prenda de ejemplo: se ve hasta que eliges una colección en la sección.
  Con "Mostrar fotos de demostración" activado usa fotos reales de ejemplo.
  Param: index
{%- endcomment -%}
{%- liquid
  assign i = index | default: 1 | minus: 1 | modulo: 8
  assign photos = 'demo-perchero-plumifero,demo-sudaderas-perchero,demo-camiseta-negra,demo-chaquetas-plano,demo-punto,demo-camisa-blanca,demo-vaqueros,demo-outfit-plano-2' | split: ','
  assign vendors = 'Moncler,Corteiz,Stone Island,The North Face,Ralph Lauren,Carhartt WIP,Levi’s,Corteiz' | split: ','
  assign titles = 'Plumífero Maya negro,Sudadera con capucha,Camiseta básica negra,Chaqueta Nuptse 1996,Jersey de punto,Camisa Oxford blanca,Vaqueros 501 azul,Pack pantalón + camiseta' | split: ','
  assign prices = '69000,9500,6500,18500,8900,5500,4500,7900' | split: ','
  assign compares = '129000,18000,11000,32000,16000,9900,9500,14000' | split: ','
  assign sizes = 'M,L,S,M,L,M,32,M' | split: ','
  assign conditions = 'Como nuevo,Nuevo con etiqueta,Excelente,Como nuevo,Excelente,Nuevo con etiqueta,Como nuevo,Muy bueno' | split: ','
  assign price = prices[i] | plus: 0
  assign compare = compares[i] | plus: 0
  assign n = i | modulo: 4 | plus: 1
  assign ph = 'product-apparel-' | append: n
-%}
<div class="card card--placeholder">
  <div class="card__media">
    {%- if settings.show_demo_images -%}
      {% render 'demo-image', name: photos[i] %}
    {%- else -%}
      <div class="card__placeholder">{{ ph | placeholder_svg_tag }}</div>
    {%- endif -%}
    <div class="card__badges">
      {%- if compare > price -%}
        {%- assign saving = compare | minus: price | times: 100.0 | divided_by: compare | round -%}
        <span class="badge">−{{ saving }}%</span>
      {%- endif -%}
      <span class="badge">{{ settings.unique_piece_label | default: 'Pieza única' }}</span>
    </div>
  </div>
  <p class="card__vendor">{%- if settings.show_demo_images -%}{{ vendors[i] }}{%- else -%}{{ 'placeholders.vendor' | t }}{%- endif -%}</p>
  <p class="card__title">{%- if settings.show_demo_images -%}{{ titles[i] }}{%- else -%}{{ 'placeholders.product' | t }}{%- endif -%}</p>
  <div class="card__meta"><span>{{ 'products.product.size' | t }} {{ sizes[i] }}</span><span>{{ conditions[i] }}</span></div>
  <div class="price{% if compare > price %} price--sale{% endif %}">
    <span class="price__current">{{ price | money }}</span>
    {%- if compare > price -%}<s class="price__compare">{{ compare | money }}</s>{%- endif -%}
  </div>
</div>
