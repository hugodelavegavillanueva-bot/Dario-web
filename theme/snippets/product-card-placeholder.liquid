{%- comment -%} Prenda de muestra (se ve hasta que eliges una colección). Param: index {%- endcomment -%}
{%- assign n = index | default: 1 | modulo: 4 | plus: 1 -%}
{%- assign ph = 'product-apparel-' | append: n -%}
<div class="card card--placeholder">
  <div class="card__media"><div class="card__placeholder">{{ ph | placeholder_svg_tag }}</div></div>
  <p class="card__vendor">{{ 'placeholders.vendor' | t }}</p>
  <p class="card__title">{{ 'placeholders.product' | t }}</p>
  <div class="card__meta"><span>{{ 'products.product.size' | t }} M</span><span>{{ 'placeholders.condition' | t }}</span></div>
  <div class="price">{{ 19000 | money }}</div>
</div>
