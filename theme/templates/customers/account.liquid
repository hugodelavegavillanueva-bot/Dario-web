<div class="page-width" style="padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 4vw, 3.5rem);">
  <div class="page-header" style="padding-top:0;">
    <span class="eyebrow">{{ 'customer.account.title' | t }}</span>
    <h1>{{ 'customer.account.hello' | t: name: customer.first_name }}</h1>
    <a href="{{ routes.account_logout_url }}" class="link-underline">{{ 'customer.account.logout' | t }}</a>
  </div>
  <div style="display:grid;grid-template-columns:2fr 1fr;gap:3rem;" class="customer-grid">
    <div>
      <h2 class="h3">{{ 'customer.account.orders' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="customer-table">
            <thead><tr><th>{{ 'customer.order.number' | t }}</th><th>{{ 'customer.order.date' | t }}</th><th>{{ 'customer.order.status' | t }}</th><th>{{ 'customer.order.total' | t }}</th></tr></thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a href="{{ order.customer_url }}" style="text-decoration:underline;">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: format: 'date' }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <p class="muted">{{ 'customer.account.no_orders' | t }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
    <div>
      <h2 class="h3">{{ 'customer.account.details' | t }}</h2>
      {{ customer.default_address | format_address }}
      <p style="margin-top:1rem;"><a href="{{ routes.account_addresses_url }}" class="link-underline">{{ 'customer.account.addresses' | t }} ({{ customer.addresses_count }})</a></p>
    </div>
  </div>
</div>
<style>@media (max-width: 749px){ .customer-grid{ grid-template-columns:1fr !important; } }</style>
