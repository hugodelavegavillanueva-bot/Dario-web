<div class="page-width">
  <div class="customer">
    <h1>{{ 'customer.reset.title' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="field"><label class="field__label" for="ResetPassword">{{ 'customer.password' | t }}</label><input class="field__input" type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password"></div>
      <div class="field"><label class="field__label" for="ResetConfirm">{{ 'customer.password_confirm' | t }}</label><input class="field__input" type="password" id="ResetConfirm" name="customer[password_confirmation]" autocomplete="new-password"></div>
      <button class="button button--full">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>
