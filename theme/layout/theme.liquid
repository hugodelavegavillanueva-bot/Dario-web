<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}" data-cart-type="{{ settings.cart_type }}">
    <a class="skip-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    <div class="modal" id="QuickView" aria-hidden="true" role="dialog" aria-modal="true">
      <div class="drawer__overlay" data-modal-close></div>
      <div class="modal__panel">
        <button type="button" class="drawer__close modal__close" data-modal-close aria-label="{{ 'general.close' | t }}">{% render 'icon', icon: 'close' %}</button>
        <div class="modal__content" data-quick-view-content></div>
      </div>
    </div>

    <div class="toast" data-toast role="status" aria-live="polite"></div>

    {%- if settings.back_to_top -%}
      <button type="button" class="back-to-top" data-back-to-top aria-label="{{ 'general.back_to_top' | t }}">↑</button>
    {%- endif -%}

    <script>
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          error: {{ 'general.error' | t | json }},
          wishlistAdded: {{ 'wishlist.added' | t | json }},
          wishlistRemoved: {{ 'wishlist.removed' | t | json }},
          copied: {{ 'general.copied' | t | json }}
        },
        settings: {
          recentlyViewed: {{ settings.recently_viewed_track | json }}
        },
        product: {% if template.name == 'product' %}{{ product.handle | json }}{% else %}null{% endif %},
        moneyFormat: {{ shop.money_format | json }}
      };
    </script>
  </body>
</html>
