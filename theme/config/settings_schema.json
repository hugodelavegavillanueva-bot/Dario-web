[
  {
    "name": "theme_info",
    "theme_name": "Maison Archive",
    "theme_version": "2.0.0",
    "theme_author": "Custom",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Marca",
    "settings": [
      {
        "type": "text",
        "id": "store_name",
        "label": "Nombre de la tienda",
        "default": "TU MARCA",
        "info": "Se muestra en la cabecera (si no subes logo), el pie y el título del navegador."
      },
      {
        "type": "text",
        "id": "store_tagline",
        "label": "Frase corta (título del navegador en portada)",
        "default": "Moda de segunda mano seleccionada"
      }
    ]
  },
  {
    "name": "Colores",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Fondo",
        "default": "#F5F2EC"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Fondo secundario (tarjetas, bloques)",
        "default": "#ECE7DF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Texto",
        "default": "#141414"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Texto secundario",
        "default": "#6E6A63"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Acento (detalles dorados)",
        "default": "#9A8466"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Bordes",
        "default": "#D9D3C8"
      },
      {
        "type": "color",
        "id": "color_dark",
        "label": "Fondo oscuro (secciones invertidas)",
        "default": "#141414"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Precio rebajado",
        "default": "#8A3B2E"
      }
    ]
  },
  {
    "name": "Tipografía",
    "settings": [
      {
        "type": "select",
        "id": "heading_font",
        "label": "Fuente de títulos",
        "options": [
          {
            "value": "cormorant",
            "label": "Cormorant Garamond (serif editorial)"
          },
          {
            "value": "inter",
            "label": "Inter (sans moderna)"
          }
        ],
        "default": "cormorant"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Escala de títulos",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "Escala del texto",
        "min": 90,
        "max": 115,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Ancho máximo de página",
        "min": 1200,
        "max": 1800,
        "step": 50,
        "unit": "px",
        "default": 1600
      },
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Proporción de imagen en tarjetas de producto",
        "options": [
          {
            "value": "portrait",
            "label": "Retrato 4:5"
          },
          {
            "value": "tall",
            "label": "Alta 2:3"
          },
          {
            "value": "square",
            "label": "Cuadrada"
          }
        ],
        "default": "portrait"
      },
      {
        "type": "checkbox",
        "id": "card_show_secondary_image",
        "label": "Mostrar segunda imagen al pasar el ratón",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Mostrar marca en tarjetas",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_condition",
        "label": "Mostrar estado (condición) en tarjetas",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_size",
        "label": "Mostrar talla en tarjetas",
        "default": true
      }
    ]
  },
  {
    "name": "Segunda mano",
    "settings": [
      {
        "type": "paragraph",
        "content": "El estado de cada prenda se lee del metacampo de producto custom.condicion. Si no existe, se busca una etiqueta con el formato 'Condicion:Como nuevo'. La talla se lee de la variante (opción 'Talla' / 'Size') o del metacampo custom.talla."
      },
      {
        "type": "text",
        "id": "condition_tag_prefix",
        "label": "Prefijo de etiqueta para estado",
        "default": "Condicion:"
      },
      {
        "type": "text",
        "id": "unique_piece_label",
        "label": "Texto para pieza única",
        "default": "Pieza única"
      },
      {
        "type": "richtext",
        "id": "authenticity_text",
        "label": "Texto de garantía de autenticidad (ficha de producto)",
        "default": "<p>Cada pieza es verificada por nuestro equipo antes de publicarse: etiquetas, costuras, herrajes y procedencia. Si una prenda no es auténtica, te devolvemos el 100% de tu dinero.</p>"
      },
      {
        "type": "richtext",
        "id": "shipping_text",
        "label": "Texto de envío y devoluciones (ficha de producto)",
        "default": "<p>Envío asegurado en 24/48h. Devoluciones aceptadas durante 14 días siempre que la prenda conserve el precinto de autenticidad.</p>"
      }
    ]
  },
  {
    "name": "Carrito",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Tipo de carrito",
        "options": [
          {
            "value": "drawer",
            "label": "Panel lateral"
          },
          {
            "value": "page",
            "label": "Página"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "text",
        "id": "cart_note_text",
        "label": "Mensaje en el carrito",
        "default": "Envío asegurado y embalaje premium en todos los pedidos."
      },
      {
        "type": "header",
        "content": "Envío gratis"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Envío gratis a partir de (€)",
        "default": 150,
        "info": "0 para ocultar la barra de progreso. Debe coincidir con tu tarifa de envío en Shopify."
      },
      {
        "type": "header",
        "content": "Venta cruzada"
      },
      {
        "type": "collection",
        "id": "cart_upsell_collection",
        "label": "Colección para sugerir en el carrito"
      },
      {
        "type": "text",
        "id": "cart_upsell_heading",
        "label": "Título de sugerencias",
        "default": "Combínalo con"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Permitir nota / envolver para regalo en el carrito lateral",
        "default": true
      }
    ]
  },
  {
    "name": "Funciones de tienda",
    "settings": [
      {
        "type": "checkbox",
        "id": "wishlist_enabled",
        "label": "Activar favoritos (corazón)",
        "default": true
      },
      {
        "type": "page",
        "id": "wishlist_page",
        "label": "Página de favoritos",
        "info": "Crea una página con la plantilla 'page.favoritos'."
      },
      {
        "type": "checkbox",
        "id": "quick_view_enabled",
        "label": "Activar vista rápida en tarjetas",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "back_to_top",
        "label": "Botón 'volver arriba'",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "recently_viewed_track",
        "label": "Guardar productos vistos recientemente",
        "default": true
      },
      {
        "type": "header",
        "content": "Ficha de producto"
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp para consultas (con prefijo, sin +)",
        "info": "Ej: 34600111222. Muestra el botón 'Preguntar por esta prenda'."
      },
      {
        "type": "range",
        "id": "delivery_min_days",
        "label": "Entrega estimada: mínimo",
        "min": 1,
        "max": 10,
        "step": 1,
        "unit": "d",
        "default": 1
      },
      {
        "type": "range",
        "id": "delivery_max_days",
        "label": "Entrega estimada: máximo",
        "min": 1,
        "max": 15,
        "step": 1,
        "unit": "d",
        "default": 3
      },
      {
        "type": "checkbox",
        "id": "show_share",
        "label": "Botones de compartir",
        "default": true
      },
      {
        "type": "richtext",
        "id": "size_guide_text",
        "label": "Guía de tallas por defecto (si no eliges página)",
        "default": "<p>Nuestras prendas indican la talla de la etiqueta original. En la pestaña 'Medidas' encontrarás las medidas reales tomadas en plano. ¿Dudas? Escríbenos y te asesoramos.</p>"
      }
    ]
  },
  {
    "name": "Redes sociales",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram",
        "info": "https://instagram.com/tu_tienda"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok"
      },
      {
        "type": "text",
        "id": "social_whatsapp",
        "label": "WhatsApp (enlace wa.me)"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Imagen",
        "info": "32 x 32px .png"
      }
    ]
  }
]